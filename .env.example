# Environment variables template.
# Copy this file to `local.env` (preferred — overrides .env) or `.env`.
# DO NOT commit `.env` / `local.env` to version control (see .gitignore).
#
# Values are read centrally via Pydantic BaseSettings in backend/src/config.py
# (singleton `config.settings`). Precedence:
#   1) real environment variables (highest)
#   2) local.env
#   3) .env
#   (the last env file defined wins when both set the same key)
#
# --- STATUS ---
# The previous ODDS_API_KEY (9b49...f83) was committed to git in v2.0 and is
# considered PUBLIC. It MUST be rotated on https://the-odds-api.com before use.
# Generate a NEW key, paste it in `local.env`, and never commit that file.

# ---------------------------------------------------------------------------
# TheOddsAPI — live market odds for value-bet detection
# Free tier: 500 requests/month  ->  https://the-odds-api.com
# ---------------------------------------------------------------------------
# 1) Sign in at https://the-odds-api.com
# 2) Delete the compromised key (9b49...f83) and generate a NEW one
# 3) Copy the new key from the dashboard
# 4) Paste below in `local.env` (no quotes):
ODDS_API_KEY=your_api_key_here

# Optional personal market research: no paid calls unless explicitly enabled.
# Sport keys must come from the provider's current authorized catalog.
TENNISBOT_MARKET_ODDS_ENABLED=false
TENNISBOT_MARKET_SPORTS=
TENNISBOT_MARKET_REQUESTS_PER_DAY=10
TENNISBOT_VALUE_MIN_DECIMAL_ODDS=1.40

# Optional: API bind port (default 9090)
# TENNISBOT_API_PORT=9090

# ---------------------------------------------------------------------------
# LLM provider for player-news research (optional)
# Without a key, player_news falls back to a no-key DuckDuckGo search and
# returns neutral (0) feature values — research is not active.
# To enable injury/form research:
#   - Pick one provider (openai | anthropic | ollama)
#   - Paste the corresponding key in `local.env`
#   - pip install gpt-researcher (optional, for autonomous research)
# ---------------------------------------------------------------------------
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
